# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ImageKit
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
VITE_IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint
VITE_IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Canonical site URL — used for product page SEO tags (canonical link, OG
# tags, JSON-LD). Must be set for real in Vercel's project env vars, since
# build-time prerendering always runs against a local preview server and
# would otherwise bake in a localhost URL. Update this when moving from the
# Vercel URL to the real kenwell.in domain.
VITE_SITE_URL=https://your-project.vercel.app
